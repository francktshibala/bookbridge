# Dependencies
node_modules

# Environment files
.env
.env.local
.env.production
.env.local.bak
.env.development.local

# Build outputs
.next/
out/
dist/

# Vercel
.vercel

# Local certificates (not needed for Vercel)
certificates/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
coverage/

# IDE files
.vscode/
.idea/

# OS generated files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp

# Cache
.next/cache
# Audio files (using CDN)
/public/audio/
# Exception for demo audio files
!/public/audio/demo/
!/public/audio/demo/**

# Social media audio files (stored on Desktop/Google Drive, not in repo)
docs/social-media/**/*.mp3
docs/social-media/**/*.txt

# TypeScript incremental build cache
*.tsbuildinfo

# Generated/cached audio (large binaries, not source)
cache/audio/
temp/

# User data exports - must never be committed (contains PII)
docs/users/

# Stray artifact from a script writing to a literal "~" path instead of $HOME
~/